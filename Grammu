-- // Drawing & Rendering Backend Logic
local FOVCircle = Drawing.new("Circle")
FOVCircle.Thickness = 2
FOVCircle.NumSides = 64
FOVCircle.Filled = false
FOVCircle.Transparency = 1

local TracerLines = {}

local function GetClosestTarget()
    local target = nil
    local shortestDist = math.huge
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local screenPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                if onScreen then
                    local mousePos = Vector2.new(Mouse.X, Mouse.Y)
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                    if dist <= ScriptSettings.SilentAimFOV and dist < shortestDist then
                        shortestDist = dist
                        target = hrp
                    end
                end
            end
        end
    end
    return target
end

local oldIndex
oldIndex = hookmetamethod(game, "__index", function(self, k)
    if KeyAuthenticated and ScriptSettings.SilentAimEnabled and not checkcaller() and self == Mouse and k == "Hit" then
        local target = GetClosestTarget()
        if target then
            return target.CFrame
        end
    end
    return oldIndex(self, k)
end)

RunService.RenderStepped:Connect(function()
    if not KeyAuthenticated then return end

    FOVCircle.Visible = ScriptSettings.SilentAimEnabled
    FOVCircle.Radius = ScriptSettings.SilentAimFOV
    FOVCircle.Color = ScriptSettings.SilentAimFOVColor
    FOVCircle.Position = Vector2.new(Mouse.X, Mouse.Y + 36)

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            local head = char:FindFirstChild("Head")
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local humanoid = char:FindFirstChild("Humanoid")
            
            if head then
                head.Size = Vector3.new(ScriptSettings.HeadHitboxSize, ScriptSettings.HeadHitboxSize, ScriptSettings.HeadHitboxSize)
                head.CanCollide = false
            end
            if hrp then
                hrp.Size = Vector3.new(ScriptSettings.BodyHitboxSize, ScriptSettings.BodyHitboxSize, ScriptSettings.BodyHitboxSize)
                hrp.CanCollide = false
            end

            local highlight = char:FindFirstChild("ScriptHighlight")
            if ScriptSettings.ESPEnabled then
                if not highlight then
                    highlight = Instance.new("Highlight")
                    highlight.Name = "ScriptHighlight"
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    highlight.Parent = char
                end
                highlight.FillColor = ScriptSettings.ESPColor
            else
                if highlight then highlight:Destroy() end
            end

            if ScriptSettings.ESPTracer and hrp then
                local tracer = TracerLines[player]
                if not tracer then
                    tracer = Drawing.new("Line")
                    tracer.Thickness = 1.5
                    TracerLines[player] = tracer
                end
                local screenPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                if onScreen then
                    tracer.Visible = true
                    tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                    tracer.To = Vector2.new(screenPos.X, screenPos.Y)
                    tracer.Color = ScriptSettings.ESPTracerColor
                else
                    tracer.Visible = false
                end
            else
                if TracerLines[player] then
                    TracerLines[player]:Remove()
                    TracerLines[player] = nil
                end
            end

            local bg = char:FindFirstChild("ESPTextGui")
            if ScriptSettings.ESPName and hrp and humanoid then
                if not bg then
                    bg = Instance.new("BillboardGui")
                    bg.Name = "ESPTextGui"
                    bg.Size = UDim2.new(0, 100, 0, 50)
                    bg.StudsOffset = Vector3.new(0, 3, 0)
                    bg.AlwaysOnTop = true
                    bg.Parent = char

                    local textLabel = Instance.new("TextLabel")
                    textLabel.Name = "Info"
                    textLabel.Size = UDim2.new(1, 0, 1, 0)
                    textLabel.BackgroundTransparency = 1
                    textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                    textLabel.TextStrokeTransparency = 0
                    textLabel.TextSize = 14
                    textLabel.Parent = bg
                end
                local dist = math.floor((hrp.Position - Camera.CFrame.Position).Magnitude)
                bg.Info.Text = string.format("%s\n[%dm] | HP: %d", player.Name, dist, math.floor(humanoid.Health))
            else
                if bg then bg:Destroy() end
            end
        end
    end
end)

Players.PlayerRemoving:Connect(function(player)
    if TracerLines[player] then
        TracerLines[player]:Remove()
        TracerLines[player] = nil
    end
end)

RunService.Stepped:Connect(function()
