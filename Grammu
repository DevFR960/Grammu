--// FUNCTIONS
local function InFOV(pos)
    local c = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    return (Vector2.new(pos.X, pos.Y) - c).Magnitude <= Config.FOV
end

local function IsEnemy(p)
    if not Config.TeamCheck then return true end
    if not p.Team or not LocalPlayer.Team then return true end
    return p.Team ~= LocalPlayer.Team
end

--// WALLCHECK
local function IsVisible(part, char)
    if not Config.WallCheck then return true end

    local origin = Camera.CFrame.Position
    local direction = (part.Position - origin)

    local params = RaycastParams.new()
    params.FilterDescendantsInstances = {LocalPlayer.Character, char}
    params.FilterType = Enum.RaycastFilterType.Blacklist

    local result = workspace:Raycast(origin, direction, params)
    return result == nil or result.Instance:IsDescendantOf(char)
end

--// TARGET
local function GetTarget()
    local closest, shortest = nil, Config.FOV

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local part = p.Character:FindFirstChild(Config.AimPart)

            if part and IsEnemy(p) and IsVisible(part, p.Character) then
                local pos, vis = Camera:WorldToViewportPoint(part.Position)
                if vis then
                    local dist = (Vector2.new(pos.X, pos.Y) - Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)).Magnitude
                    if dist < shortest then
                        shortest = dist
                        closest = part
                    end
                end
            end
        end
    end

    LockedTarget = closest
end

--// HITBOX (Updated to support Head)
local function ApplyHitbox(p)
    if not p.Character then return end
    
    -- Find Part based on Config (Head or HumanoidRootPart)
    local targetPart = p.Character:FindFirstChild(Config.HitboxPart)
    if not targetPart then return end

    if Config.Hitbox then
        if targetPart.Size.X ~= Config.HitboxSize then
            targetPart.Size = Vector3.new(Config.HitboxSize, Config.HitboxSize, Config.HitboxSize)
            targetPart.Transparency = 0.5
            targetPart.CanCollide = false
            
            -- Prevents the head from causing weird physics/movement when expanded
            targetPart.Massless = true 
        end
    else
        -- Restore original size when Hitbox is turned off
        if Config.HitboxPart == "Head" then
            if targetPart.Size.X ~= 1.2 then
                targetPart.Size = Vector3.new(1.2, 1.2, 1.2) -- Standard Head size
                targetPart.Transparency = 0
                targetPart.CanCollide = true
                targetPart.Massless = false
            end
        elseif Config.HitboxPart == "HumanoidRootPart" then
            if targetPart.Size.X ~= 2 then
                targetPart.Size = Vector3.new(2, 2, 1) -- Standard RootPart size
                targetPart.Transparency = 1
                targetPart.CanCollide = true
                targetPart.Massless = false
            end
        end
    end
end

--// MOVEMENT
local function ApplyMovement()
    local char = LocalPlayer.Character
    if not char then return end

    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    if Config.SpeedEnabled then hum.WalkSpeed = Config.WalkSpeed else hum.WalkSpeed = 16 end
    if Config.JumpEnabled then
        hum.UseJumpPower = true
        hum.JumpPower = Config.JumpPower
    else
        hum.UseJumpPower = true
        hum.JumpPower = 50
    end
    if Config.GravityEnabled then workspace.Gravity = Config.Gravity else workspace.Gravity = 196.2 end
end

--// CREATE ESP
local function CreateESP(p)
    if p == LocalPlayer or ESP[p] then return end

    local gui = Instance.new("BillboardGui")
    gui.Size = UDim2.new(4, 0, 5, 0)
    gui.AlwaysOnTop = true
    pcall(function() gui.Parent = GUIParent end)

    local text = Instance.new("TextLabel", gui)
    text.Size = UDim2.new(1, 0, 1, 0)
    text.BackgroundTransparency = 1
    text.TextScaled = true

    local tracer = nil
    pcall(function()
        tracer = Drawing.new("Line")
        tracer.Thickness = 1.5
    end)

    local hl = Instance.new("Highlight")
    pcall(function() hl.Parent = GUIParent end)

    ESP[p] = {GUI = gui, Text = text, Tracer = tracer, HL = hl}
end

--// REMOVE ESP
local function RemoveESP(p)
    if ESP[p] then
        if ESP[p].GUI then ESP[p].GUI:Destroy() end
        if ESP[p].Tracer then ESP[p].Tracer:Remove() end
        if ESP[p].HL then ESP[p].HL:Destroy() end
        ESP[p] = nil
    end
end

--// LOOP
RunService.RenderStepped:Connect(function()
    -- FOV
    if FOVCircle then
        FOVCircle.Radius = Config.FOV
        FOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        FOVCircle.Visible = Config.ShowFOV and Config.Aimbot
        FOVCircle.Color = Config.Rainbow and Color3.fromHSV((tick() % 5) / 5, 1, 1) or Config.Colors.FOV
    end

    GetTarget()

    -- AIMBOT
    if Config.Aimbot and LockedTarget then
        local vel = LockedTarget.AssemblyLinearVelocity or Vector3.new(0,0,0)
        local pred = LockedTarget.Position + (vel * Config.Prediction)
        Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, pred)
    end

    ApplyMovement()

    for p, v in pairs(ESP) do
        if p and p.Character and p.Character:FindFirstChild("Head") then
            local char = p.Character
            local head = char.Head

            ApplyHitbox(p)

            if Config.ESP then
                local color = Config.TeamColor and p.TeamColor.Color or Config.Colors.ESP
                if Config.Rainbow then color = Color3.fromHSV((tick() % 5) / 5, 1, 1) end

                if Config.TextESP then
                    v.GUI.Adornee = head
                    v.GUI.Enabled = true
                    v.Text.Text = p.Name
                    v.Text.TextColor3 = color
                else
                    v.GUI.Enabled = false
                end

                if v.Tracer and Config.Tracer then
                    local pos, vis = Camera:WorldToViewportPoint(head.Position)
                    if vis and InFOV(pos) then
                        v.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                        v.Tracer.To = Vector2.new(pos.X, pos.Y)
                        v.Tracer.Color = color
                        v.Tracer.Visible = true
                    else
                        v.Tracer.Visible = false
                    end
                else
                    if v.Tracer then v.Tracer.Visible = false end
                end

                if Config.Highlight then
                    v.HL.Adornee = char
                    v.HL.FillColor = color
                    v.HL.Enabled = true
                else
                    v.HL.Enabled = false
                end
            else
                v.GUI.Enabled = false
                if v.Tracer then v.Tracer.Visible = false end
                v.HL.Enabled = false
            end
        else
            v.GUI.Enabled = false
            if v.Tracer then v.Tracer.Visible = false end
            v.HL.Enabled = false
        end
    end
end)

