-- // UI Framework Window Construction
local Library = { Flags = {} }

function Library:CreateWindow(WindowTitle)
    local Window = {}
    
    function Window:CreateTab(TabName)
        local Tab = {}
        
        function Tab:CreateToggle(Data)
            Library.Flags[Data.Flag or Data.Name] = {
                CurrentValue = Data.CurrentValue or false,
                Set = function(self, val) 
                    self.CurrentValue = val 
                    pcall(function() Data.Callback(val) end)
                end
            }
            if Data.CurrentValue then
                pcall(function() Data.Callback(true) end)
            end
        end

        function Tab:CreateSlider(Data)
            Library.Flags[Data.Flag or Data.Name] = {
                CurrentValue = Data.CurrentValue or Data.Range[1],
                Set = function(self, val) 
                    self.CurrentValue = val 
                    pcall(function() Data.Callback(val) end)
                end
            }
            pcall(function() Data.Callback(Data.CurrentValue or Data.Range[1]) end)
        end

        function Tab:CreateColorPicker(Data)
            Library.Flags[Data.Flag or Data.Name] = {
                CurrentColor = Data.Color or Color3.fromRGB(255, 255, 255),
                Set = function(self, col) 
                    self.CurrentColor = col 
                    pcall(function() Data.Callback(col) end)
                end
            }
        end

        function Tab:CreateLabel(Text)
            -- Label element handler
        end

        return Tab
    end
    return Window
end

