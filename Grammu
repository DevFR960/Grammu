local function IsEnemy(player)
   if player == LocalPlayer then return false end
   if not Settings.TeamCheck then return true end

   if LocalPlayer.Team and player.Team then
      if LocalPlayer.Team == player.Team then return false end
   end
   if LocalPlayer.TeamColor and player.TeamColor then
      if LocalPlayer.TeamColor == player.TeamColor then return false end
   end
   return true
end

local function IsVisible(targetPart)
   if not Settings.WallCheck then return true end
   if not LocalPlayer.Character or not targetPart then return false end
   
   local character = targetPart.Parent
   local origin = Camera.CFrame.Position
   local direction = targetPart.Position - origin
   
   local ignoreList = {LocalPlayer.Character, character, Camera}
   local params = RaycastParams.new()
   params.FilterType = Enum.RaycastFilterType.Exclude
   params.IgnoreWater = true
   
   for i = 1, 3 do
      params.FilterDescendantsInstances = ignoreList
      local result = workspace:Raycast(origin, direction, params)
      if not result then return true end
      if result.Instance.Transparency >= 0.5 or not result.Instance.CanCollide or result.Instance.Name == "HumanoidRootPart" then
         table.insert(ignoreList, result.Instance)
      else
         return false 
      end
   end
   return false
end

local function GetClosestPlayer()
   local target = nil
   local shortestDist = Settings.FOV
   local centerScreen = Camera.ViewportSize / 2
   
   for _, player in ipairs(Players:GetPlayers()) do
      if IsEnemy(player) and player.Character then
         local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
         local head = player.Character:FindFirstChild("Head")
         
         if humanoid and humanoid.Health > 0 and head then
            local screenPoint, onScreen = Camera:WorldToViewportPoint(head.Position)
            
            if onScreen then
               local screenPos = Vector2.new(screenPoint.X, screenPoint.Y)
               local dist = (centerScreen - screenPos).Magnitude
               
               if dist < shortestDist and IsVisible(head) then
                  shortestDist = dist
                  target = head
               end
            end
         end
      end
   end
   return target
end

local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local args = {...}
    local method = getnamecallmethod()
    
    if Settings.SilentAim and not checkcaller() then
        local targetHead = GetClosestPlayer()
        if targetHead then
            if method == "Raycast" then
                local origin = args[1]
                local oldDirection = args[2]
                local newDirection = (targetHead.Position - origin).Unit * oldDirection.Magnitude
                args[2] = newDirection
                return oldNamecall(self, unpack(args))
            elseif method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList" or method == "FindPartOnRayWithWhitelist" then
                local oldRay = args[1]
                local newRay = Ray.new(oldRay.Origin, (targetHead.Position - oldRay.Origin).Unit * oldRay.Direction.Magnitude)
                args[1] = newRay
                return oldNamecall(self, unpack(args))
            end
        end
    end
    return oldNamecall(self, ...)
end)

local function UpdateBillboard(player, head, humanoid, hrp)
   local bb = head:FindFirstChild("SnyX_ESP")
   if Settings.ESPName or Settings.ESPHealth or Settings.ESPDistance then
      if not bb then
         bb = Instance.new("BillboardGui", head)
         bb.Name = "SnyX_ESP"
         bb.Size = UDim2.new(0, 120, 0, 45)
         bb.StudsOffset = Vector3.new(0, 3, 0)
         bb.AlwaysOnTop = true

         local label = Instance.new("TextLabel", bb)
         label.Name = "TextInfo"
         label.Size = UDim2.new(1, 0, 0.6, 0)
         label.BackgroundTransparency = 1
         label.TextStrokeTransparency = 0
         label.TextScaled = true
         
         local hpBg = Instance.new("Frame", bb)
         hpBg.Name = "HP_BG"
         hpBg.Size = UDim2.new(0.8, 0, 0.15, 0)
         hpBg.Position = UDim2.new(0.1, 0, 0.7, 0)
         hpBg.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
         hpBg.BorderSizePixel = 1
         hpBg.BorderColor3 = Color3.fromRGB(0, 0, 0)
         
         local hpFill = Instance.new("Frame", hpBg)
         hpFill.Name = "HP_Fill"
         hpFill.Size = UDim2.new(1, 0, 1, 0)
         hpFill.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
         hpFill.BorderSizePixel = 0
      end

      local text = ""
      if Settings.ESPName then text = text .. player.Name .. "\n" end
      if Settings.ESPDistance and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
         local dist = math.floor((LocalPlayer.Character.HumanoidRootPart.Position - hrp.Position).Magnitude)
         text = text .. dist .. "m"
      end
      bb.TextInfo.Text = text
      bb.TextInfo.TextColor3 = Settings.TextColor
      bb.TextInfo.Visible = (Settings.ESPName or Settings.ESPDistance)

      if Settings.ESPHealth then
         bb.HP_BG.Visible = true
         local maxHealth = humanoid.MaxHealth > 0 and humanoid.MaxHealth or 100
         local healthPct = math.clamp(humanoid.Health / maxHealth, 0, 1)
         bb.HP_BG.HP_Fill.Size = UDim2.new(healthPct, 0, 1, 0)
         bb.HP_BG.HP_Fill.BackgroundColor3 = Color3.fromRGB(255, 0, 0):Lerp(Color3.fromRGB(0, 255, 0), healthPct)
      else
         bb.HP_BG.Visible = false
      end
   else
      if bb then bb:Destroy() end
   end
end

RunService.RenderStepped:Connect(function()
   pcall(function()
      local centerScreen = Camera.ViewportSize / 2

      if FOVFrame then
         FOVFrame.Visible = Settings.DrawFOV
         if Settings.DrawFOV then
            FOVFrame.Size = UDim2.new(0, Settings.FOV * 2, 0, Settings.FOV * 2)
            FOVStroke.Color = Settings.FOVColor
         end
      end

      if Settings.Aimbot then
         local targetHead = GetClosestPlayer()
         if targetHead then
            Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, targetHead.Position)
         end
      end

      for _, player in ipairs(Players:GetPlayers()) do
         if player ~= LocalPlayer then
            local char = player.Character
            local isEnemy = IsEnemy(player)

            if char then
               local rootPart = char:FindFirstChild("HumanoidRootPart")
               local head = char:FindFirstChild("Head")
               local humanoid = char:FindFirstChildOfClass("Humanoid")

               if rootPart then
                  if Settings.BodyHitbox and isEnemy then
                     rootPart.Size = Vector3.new(Settings.BodySize, Settings.BodySize, Settings.BodySize)
                     rootPart.Transparency = 0.7
                     rootPart.CanCollide = false
                  else
                     rootPart.Size = Vector3.new(2, 2, 1)
                     rootPart.Transparency = 1
                  end
               end

               if head then
                  if Settings.HeadHitbox and isEnemy then
                     head.Size = Vector3.new(Settings.HeadSize, Settings.HeadSize, Settings.HeadSize)
                     head.Transparency = 0.7
                     head.CanCollide = false
                  else
                     head.Size = Vector3.new(1.2, 1.2, 1.2)
                  end
               end

               if char and rootPart and humanoid and humanoid.Health > 0 and isEnemy then
                  if Settings.ESPBox then
                     local hl = char:FindFirstChild("SnyX_HL") or Instance.new("Highlight", char)
                     hl.Name = "SnyX_HL"
                     hl.FillTransparency = 0.5
                     hl.FillColor = Settings.BoxColor
                     hl.OutlineColor = Settings.BoxColor
                  else
                     if char:FindFirstChild("SnyX_HL") then char.SnyX_HL:Destroy() end
                  end

                  if head then
                     UpdateBillboard(player, head, humanoid, rootPart)
                  end

                  if Settings.ESPLine then
                     local pos, vis = Camera:WorldToViewportPoint(rootPart.Position)
                     local tracer = TracerPool[player] or Drawing.new("Line")
                     if vis then
                        tracer.Visible = true
                        tracer.From = Vector2.new(centerScreen.X, Camera.ViewportSize.Y)
                        tracer.To = Vector2.new(pos.X, pos.Y)
                        tracer.Color = Settings.LineColor
                        tracer.Thickness = 1
                     else
                        tracer.Visible = false
                     end
                     TracerPool[player] = tracer
                  elseif TracerPool[player] then
                     TracerPool[player].Visible = false
                  end
               else
                  if char:FindFirstChild("SnyX_HL") then char.SnyX_HL:Destroy() end
                  if head and head:FindFirstChild("SnyX_ESP") then head.SnyX_ESP:Destroy() end
                  if TracerPool[player] then TracerPool[player].Visible = false end
               end
            end
         end
      end

      if Settings.Noclip and LocalPlayer.Character then
         for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
         end
      end

      if LocalPlayer.Character then
         for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
            if (part:IsA("BasePart") or part:IsA("Decal")) and part.Name ~= "HumanoidRootPart" then
               part.Transparency = Settings.Invisibility and 1 or 0
            end
         end
      end

      if Settings.Fly and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
         local hrp = LocalPlayer.Character.HumanoidRootPart
         local humanoid = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
         local cam = Camera.CFrame
         local moveDir = Vector3.new()
         
         if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + cam.LookVector end
         if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - cam.LookVector end
         if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - cam.RightVector end
         if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + cam.RightVector end
         
         if moveDir.Magnitude == 0 and humanoid and humanoid.MoveDirection.Magnitude > 0 then
            moveDir = humanoid.MoveDirection
         end
         
         hrp.AssemblyLinearVelocity = moveDir * Settings.FlySpeed
      end
   end)
end)

