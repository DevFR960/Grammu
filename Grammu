-- WallCheck Function
local function IsVisible(targetPart)
    if not getgenv().SINEX_Settings.WallCheck then return true end
    local origin = Camera.CFrame.Position
    local direction = targetPart.Position - origin
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
    
    local ignore = {LocalPlayer.Character}
    if targetPart.Parent then
        table.insert(ignore, targetPart.Parent)
    end
    raycastParams.FilterDescendantsInstances = ignore
    raycastParams.IgnoreWater = true
    
    local result = workspace:Raycast(origin, direction, raycastParams)
    return result == nil
end

-- Aimbot Target Calculation with WallCheck & Accuracy
local function GetClosestPlayer()
    local target = nil
    local shortestDist = getgenv().SINEX_Settings.AimFov
    local mousePos
    pcall(function()
        mousePos = UserInputService:GetMouseLocation()
    end)
    if not mousePos then mousePos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2) end

    for _, v in pairs(Players:GetPlayers()) do
        if v ~= LocalPlayer and v.Character then
            local partName = getgenv().SINEX_Settings.AimPart
            local targetPart = v.Character:FindFirstChild(partName)
            local rootPart = v.Character:FindFirstChild("HumanoidRootPart")
            local humanoid = v.Character:FindFirstChild("Humanoid")

            if targetPart and rootPart and humanoid and humanoid.Health > 0 then
                if not getgenv().SINEX_Settings.TeamCheck or v.Team ~= LocalPlayer.Team then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(rootPart.Position)
                    if onScreen and IsVisible(targetPart) then
                        local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                        if dist < shortestDist then
                            shortestDist = dist
                            target = targetPart
                        end
                    end
                end
            end
        end
    end
    return target
end

-- Cleanup ESP function for a player
local function RemoveESP(v)
    if ESPStorage.Boxes[v] then
        pcall(function() ESPStorage.Boxes[v]:Remove() end)
        ESPStorage.Boxes[v] = nil
    end
    if ESPStorage.Tracers[v] then
        pcall(function() ESPStorage.Tracers[v]:Remove() end)
        ESPStorage.Tracers[v] = nil
    end
    if ESPStorage.Names[v] then
        pcall(function() ESPStorage.Names[v]:Remove() end)
        ESPStorage.Names[v] = nil
    end
    if v.Character and v.Character:FindFirstChild("SinexHighlight") then
        v.Character.SinexHighlight:Destroy()
    end
end

-- Render Loop for Aimbot & ESP
RunService.RenderStepped:Connect(function()
    -- FOV Update (GUI Version)
    local fovVisible = getgenv().SINEX_Settings.Aimbot
    FOVFrame.Visible = fovVisible
    if fovVisible then
        local fovSize = getgenv().SINEX_Settings.AimFov * 2
        FOVFrame.Size = UDim2.new(0, fovSize, 0, fovSize)
        FOVStroke.Color = getgenv().SINEX_Settings.AimColor
        local mousePos
        pcall(function()
            mousePos = UserInputService:GetMouseLocation()
        end)
        if not mousePos then mousePos = Camera.ViewportSize / 2 end
        FOVFrame.Position = UDim2.new(0, mousePos.X, 0, mousePos.Y)
    end

    -- Aimbot Execution
    if getgenv().SINEX_Settings.Aimbot then
        local targetPart = GetClosestPlayer()
        if targetPart then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetPart.Position)
        end
    end

    -- ESP Handling Loop
    for _, v in pairs(Players:GetPlayers()) do
        if v ~= LocalPlayer then
            local char = v.Character
            local humanoid = char and char:FindFirstChild("Humanoid")
            local rootPart = char and char:FindFirstChild("HumanoidRootPart")
            local head = char and char:FindFirstChild("Head")

            if char and humanoid and rootPart and head and humanoid.Health > 0 then
                local isTeam = getgenv().SINEX_Settings.TeamCheck and (v.Team == LocalPlayer.Team)
                
                -- 1. Highlight (Chams)
                local highlight = char:FindFirstChild("SinexHighlight")
                if getgenv().SINEX_Settings.ESPEnabled and getgenv().SINEX_Settings.HighlightESP and not isTeam then
                    if not highlight then
                        highlight = Instance.new("Highlight")
                        highlight.Name = "SinexHighlight"
                        highlight.Parent = char
                    end
                    highlight.FillColor = getgenv().SINEX_Settings.ESPColor
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                else
                    if highlight then highlight:Destroy() end
                end

                -- 2. Box ESP
                local box = ESPStorage.Boxes[v]
                if getgenv().SINEX_Settings.ESPEnabled and getgenv().SINEX_Settings.BoxESP and not isTeam then
                    if not box then
                        pcall(function()
                            box = Drawing.new("Square")
                            box.Filled = false
                            ESPStorage.Boxes[v] = box
                        end)
                    end
                    if box then
                        box.Thickness = getgenv().SINEX_Settings.ESPThickness
                        local vector, onScreen = Camera:WorldToViewportPoint(rootPart.Position)
                        if onScreen then
                            local size = Vector2.new(2000 / vector.Z, 3500 / vector.Z)
                            local position = Vector2.new(vector.X - size.X / 2, vector.Y - size.Y / 2)
                            box.Size = size
                            box.Position = position
                            box.Color = getgenv().SINEX_Settings.ESPColor
                            box.Visible = true
                        else
                            box.Visible = false
                        end
                    end
                else
                    if box then box.Visible = false end
                end

                -- 3. Tracers
                local tracer = ESPStorage.Tracers[v]
                if getgenv().SINEX_Settings.ESPEnabled and getgenv().SINEX_Settings.Tracers and not isTeam then
                    if not tracer then
                        pcall(function()
                            tracer = Drawing.new("Line")
                            tracer.Thickness = 1
                            ESPStorage.Tracers[v] = tracer
                        end)
                    end
                    if tracer then
                        local vector, onScreen = Camera:WorldToViewportPoint(rootPart.Position)
                        if onScreen then
                            tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                            tracer.To = Vector2.new(vector.X, vector.Y)
                            tracer.Color = getgenv().SINEX_Settings.ESPColor
                            tracer.Visible = true
                        else
                            tracer.Visible = false
                        end
                    end
                else
                    if tracer then tracer.Visible = false end
                end

                -- 4. Name, Distance & Health Text
                local nameText = ESPStorage.Names[v]
                local showInfo = getgenv().SINEX_Settings.ESPEnabled and (getgenv().SINEX_Settings.NameESP or getgenv().SINEX_Settings.DistanceESP or getgenv().SINEX_Settings.HealthESP) and not isTeam
                if showInfo then
                    if not nameText then
                        pcall(function()
                            nameText = Drawing.new("Text")
                            nameText.Size = 14
                            nameText.Center = true
                            nameText.Outline = true
                            ESPStorage.Names[v] = nameText
                        end)
                    end
                    if nameText then
                        local vector, onScreen = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 1.5, 0))
                        if onScreen then
                            local infoStr = ""
                            if getgenv().SINEX_Settings.NameESP then infoStr = infoStr .. v.Name end
                            if getgenv().SINEX_Settings.DistanceESP then
                                local dist = math.floor((rootPart.Position - Camera.CFrame.Position).Magnitude)
                                infoStr = infoStr .. " [" .. dist .. "m]"
                            end
                            if getgenv().SINEX_Settings.HealthESP then
                                infoStr = infoStr .. " | HP: " .. math.floor(humanoid.Health)
                            end
                            nameText.Text = infoStr
                            nameText.Position = Vector2.new(vector.X, vector.Y)
                            nameText.Color = getgenv().SINEX_Settings.ESPColor
                            nameText.Visible = true
                        else
                            nameText.Visible = false
                        end
                    end
                else
                    if nameText then nameText.Visible = false end
                end
            else
                RemoveESP(v)
            end
        end
    end
end)

