local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- ==========================================
-- 📱 MOBILE DEVICE CHECK
-- ==========================================
if not UserInputService.TouchEnabled then
    LocalPlayer:Kick("❌ SINEX Hub Error: This script supports MOBILE DEVICES ONLY!")
    return
end

-- ==========================================
-- 🔑 MAIN SCRIPT FUNCTION (LOADS AFTER KEY)
-- ==========================================
local function LoadMainScript()
    -- Load Luna UI Library
    local Luna = loadstring(game:HttpGet("https://raw.githubusercontent.com/harisiskandar178/Luna-UI-Library/main/source.lua"))()

    -- Create Window
    local Window = Luna:CreateWindow({
        Title = "SINEX Hub",
        Subtitle = "คนสร้างรักแฟนที่สุดในโลก",
        Center = true,
        AutoShow = true,
    })

    -- Configuration Settings Table
    local Settings = {
       Aimbot = false,
       TeamCheck = true,
       WallCheck = true,
       
       HeadHitbox = false,
       HeadSize = 5,
       BodyHitbox = false,
       BodySize = 5,
       
       ESPBox = false,
       ESPLine = false,
       ESPHealth = false,
       ESPName = false,
       ESPDistance = false,
       ESPColor = Color3.fromRGB(255, 0, 0),
       
       Fly = false,
       FlySpeed = 50,
       Noclip = false,
       Invisibility = false,
       
       FOV = 150,
       DrawFOV = true,
       FOVColor = Color3.fromRGB(255, 255, 255)
    }

    local RunService = game:GetService("RunService")
    local CoreGui = game:GetService("CoreGui")
    local Camera = workspace.CurrentCamera

    local TracerPool = {}

    -- FOV GUI System
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "SnyX_FOV_GUI"
    ScreenGui.Parent = CoreGui or LocalPlayer:WaitForChild("PlayerGui")

    local FOVFrame = Instance.new("Frame", ScreenGui)
    FOVFrame.AnchorPoint = Vector2.new(0.5, 0.5)
    FOVFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
    FOVFrame.BackgroundTransparency = 1
    FOVFrame.Visible = Settings.DrawFOV

    local FOVStroke = Instance.new("UIStroke", FOVFrame)
    FOVStroke.Thickness = 1.5
    FOVStroke.Color = Settings.FOVColor

    local FOVCorner = Instance.new("UICorner", FOVFrame)
    FOVCorner.CornerRadius = UDim.new(1, 0)

    -- Create UI Tabs
    local CombatTab = Window:CreateTab("Combat")
    local VisualsTab = Window:CreateTab("Visuals")
    local MovementTab = Window:CreateTab("Movement")

    -- COMBAT TAB
    CombatTab:CreateLabel("🔫 Aimbot & FOV Settings")
    CombatTab:CreateToggle("Aimbot (Instant Lock)", function(Value) Settings.Aimbot = Value end)
    CombatTab:CreateToggle("Team Check", function(Value) Settings.TeamCheck = Value end)
    CombatTab:CreateToggle("Wall Check (Raycast)", function(Value) Settings.WallCheck = Value end)
    CombatTab:CreateToggle("Show FOV Circle", function(Value) 
        Settings.DrawFOV = Value
        FOVFrame.Visible = Value
    end)
    CombatTab:CreateSlider("FOV Size", 50, 600, 150, function(Value) Settings.FOV = Value end)
    pcall(function()
        CombatTab:CreateColorPicker("FOV Color", Color3.fromRGB(255, 255, 255), function(Value)
            Settings.FOVColor = Value
            FOVStroke.Color = Value
        end)
    end)

    CombatTab:CreateLabel("🎯 Separate Hitbox Settings")
    CombatTab:CreateToggle("Expand Head Hitbox", function(Value) Settings.HeadHitbox = Value end)
    CombatTab:CreateSlider("Head Hitbox Size", 2, 30, 5, function(Value) Settings.HeadSize = Value end)
    CombatTab:CreateToggle("Expand Body Hitbox", function(Value) Settings.BodyHitbox = Value end)
    CombatTab:CreateSlider("Body Hitbox Size", 2, 30, 5, function(Value) Settings.BodySize = Value end)

    -- VISUALS TAB
    VisualsTab:CreateLabel("👁️ ESP Visuals")
    VisualsTab:CreateToggle("ESP Box (Chams)", function(Value) Settings.ESPBox = Value end)
    VisualsTab:CreateToggle("ESP Line (Tracer)", function(Value) Settings.ESPLine = Value end)
    VisualsTab:CreateToggle("ESP Health", function(Value) Settings.ESPHealth = Value end)
    VisualsTab:CreateToggle("ESP Name & Distance", function(Value)
        Settings.ESPName = Value
        Settings.ESPDistance = Value
    end)
    pcall(function()
        VisualsTab:CreateColorPicker("ESP Theme Color", Color3.fromRGB(255, 0, 0), function(Value) Settings.ESPColor = Value end)
    end)

    -- MOVEMENT TAB
    MovementTab:CreateLabel("🚀 Player Movement")
    MovementTab:CreateToggle("Fly", function(Value) Settings.Fly = Value end)
    MovementTab:CreateSlider("Fly Speed", 10, 200, 50, function(Value) Settings.FlySpeed = Value end)
    MovementTab:CreateToggle("Noclip", function(Value) Settings.Noclip = Value end)
    MovementTab:CreateToggle("Invisibility (Ghost)", function(Value) Settings.Invisibility = Value end)

    -- CORE LOGIC
    local function IsVisible(targetPart)
       if not Settings.WallCheck then return true end
       if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return false end
       
       local origin = Camera.CFrame.Position
       local direction = (targetPart.Position - origin)
       local raycastParams = RaycastParams.new()
       raycastParams.FilterType = Enum.RaycastFilterType.Exclude
       raycastParams.FilterDescendantsInstances = {LocalPlayer.Character, Camera}
       raycastParams.IgnoreWater = true
       
       local result = workspace:Raycast(origin, direction, raycastParams)
       if result then return result.Instance:IsDescendantOf(targetPart.Parent) end
       return true
    end

    local function GetClosestPlayer()
       local target = nil
       local shortestDist = Settings.FOV
       local centerScreen = Camera.ViewportSize / 2
       
       for _, player in ipairs(Players:GetPlayers()) do
          if player ~= LocalPlayer then
             local isEnemy = true
             if Settings.TeamCheck and player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then isEnemy = false end
             
             if isEnemy and player.Character then
                local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
                local head = player.Character:FindFirstChild("Head")
                
                if humanoid and humanoid.Health > 0 and head then
                   local screenPoint, onScreen = Camera:WorldToViewportPoint(head.Position)
                   if onScreen then
                      local screenPos = Vector2.new(screenPoint.X, screenPoint.Y)
                      local dist = (centerScreen - screenPos).Magnitude
                      if dist < shortestDist and IsVisible(head) then
                         shortestDist = dist
                         target = head
                      end
                   end
                end
             end
          end
       end
       return target
    end

    local function UpdateBillboard(player, head, humanoid, hrp)
       local bb = head:FindFirstChild("SnyX_ESP")
       if Settings.ESPName or Settings.ESPHealth or Settings.ESPDistance then
          if not bb then
             bb = Instance.new("BillboardGui", head)
             bb.Name = "SnyX_ESP"
             bb.Size = UDim2.new(0, 100, 0, 50)
             bb.StudsOffset = Vector3.new(0, 2, 0)
             bb.AlwaysOnTop = true
             local label = Instance.new("TextLabel", bb)
             label.Size = UDim2.new(1, 0, 1, 0)
             label.BackgroundTransparency = 1
             label.TextColor3 = Settings.ESPColor
             label.TextStrokeTransparency = 0
             label.TextScaled = true
          end

          local text = ""
          if Settings.ESPName then text = text .. player.Name .. "\n" end
          if Settings.ESPHealth then text = text .. "HP: " .. math.floor(humanoid.Health) .. "\n" end
          if Settings.ESPDistance and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
             local dist = math.floor((LocalPlayer.Character.HumanoidRootPart.Position - hrp.Position).Magnitude)
             text = text .. dist .. "m"
          end
          bb.TextLabel.Text = text
          bb.TextLabel.TextColor3 = Settings.ESPColor
       else
          if bb then bb:Destroy() end
       end
    end

    RunService.RenderStepped:Connect(function()
       pcall(function()
          local centerScreen = Camera.ViewportSize / 2
          if FOVFrame then FOVFrame.Size = UDim2.new(0, Settings.FOV * 2, 0, Settings.FOV * 2) end

          if Settings.Aimbot then
             local targetHead = GetClosestPlayer()
             if targetHead then Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, targetHead.Position) end
          end

          for _, player in ipairs(Players:GetPlayers()) do
             if player ~= LocalPlayer then
                local char = player.Character
                local isEnemy = not (Settings.TeamCheck and player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team)

                if char then
                   local rootPart = char:FindFirstChild("HumanoidRootPart")
                   local head = char:FindFirstChild("Head")
                   local humanoid = char:FindFirstChildOfClass("Humanoid")

                   if rootPart then
                      if Settings.BodyHitbox and isEnemy then
                         rootPart.Size = Vector3.new(Settings.BodySize, Settings.BodySize, Settings.BodySize)
                         rootPart.Transparency = 0.7
                         rootPart.CanCollide = false
                      else
                         rootPart.Size = Vector3.new(2, 2, 1)
                         rootPart.Transparency = 1
                      end
                   end

                   if head then
                      if Settings.HeadHitbox and isEnemy then
                         head.Size = Vector3.new(Settings.HeadSize, Settings.HeadSize, Settings.HeadSize)
                         head.Transparency = 0.7
                         head.CanCollide = false
                      else
                         head.Size = Vector3.new(1.2, 1.2, 1.2)
                      end
                   end

                   if char and rootPart and humanoid and humanoid.Health > 0 and isEnemy then
                      if Settings.ESPBox then
                         local hl = char:FindFirstChild("SnyX_HL") or Instance.new("Highlight", char)
                         hl.Name = "SnyX_HL"
                         hl.FillTransparency = 0.5
                         hl.FillColor = Settings.ESPColor
                         hl.OutlineColor = Settings.ESPColor
                      else
                         if char:FindFirstChild("SnyX_HL") then char.SnyX_HL:Destroy() end
                      end

                      if head then UpdateBillboard(player, head, humanoid, rootPart) end

                      if Settings.ESPLine then
                         local pos, vis = Camera:WorldToViewportPoint(rootPart.Position)
                         local tracer = TracerPool[player] or Drawing.new("Line")
                         if vis then
                            tracer.Visible = true
                            tracer.From = Vector2.new(centerScreen.X, Camera.ViewportSize.Y)
                            tracer.To = Vector2.new(pos.X, pos.Y)
                            tracer.Color = Settings.ESPColor
                            tracer.Thickness = 1
                         else
                            tracer.Visible = false
                         end
                         TracerPool[player] = tracer
                      elseif TracerPool[player] then
                         TracerPool[player].Visible = false
                      end
                   else
                      if char:FindFirstChild("SnyX_HL") then char.SnyX_HL:Destroy() end
                      if head and head:FindFirstChild("SnyX_ESP") then head.SnyX_ESP:Destroy() end
                      if TracerPool[player] then TracerPool[player].Visible = false end
                   end
                end
             end
          end

          if Settings.Noclip and LocalPlayer.Character then
             for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = false end
             end
          end

          if LocalPlayer.Character then
             for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
                if part:IsA("BasePart") or part:IsA("Decal") then
                   if part.Name ~= "HumanoidRootPart" then part.Transparency = Settings.Invisibility and 1 or 0 end
                end
             end
          end

          if Settings.Fly and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
             local hrp = LocalPlayer.Character.HumanoidRootPart
             local cam = Camera.CFrame
             local moveDir = Vector3.new()
             
             if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + cam.LookVector end
             if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - cam.LookVector end
             if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - cam.RightVector end
             if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + cam.RightVector end
             
             hrp.AssemblyLinearVelocity = moveDir * Settings.FlySpeed
             hrp.CFrame = CFrame.new(hrp.Position, hrp.Position + cam.LookVector)
          end
       end)
    end)
end

